<!-- මුළු පේජ් එකම වසා දැමීමට අවශ්‍ය කරන CSS -->
<style>
#exclusive-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.98); 
    z-index: 2147483647; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow-y: auto;
    font-family: 'Segoe UI', sans-serif;
}
</style>

<div id="exclusive-wrapper">

    <div class="ad-checker-container">
        <h3 id="displayMsg">කතාව කියවීමට පහත පියවර අනුගමනය කරන්න</h3>
        <p class="instruction" id="instructionLine">බටන් එක ඔබලා ඇඩ් එක තත්පර 5ක් බලන්න.. ඊටපස්සේ ලින්ක් එක කට් කරලා ආපහු ලින්ක් එක ඔබලා එන්න එතකොට කතාවට යන්න පුලුවන්</p>
        <div id="statusIcon">🕒</div><br>
        <button onclick="handleAdClick()" id="actionBtn" class="premium-btn">ඇඩ් එක බලන්න</button>
    </div>

    <div id="customAlert" class="modal">
        <div class="modal-content">
            <span class="modal-icon">⚠️</span>
            <p id="modalMsg"></p>
            <button onclick="closeModal()" class="modal-btn">නැවත උත්සාහ කරන්න</button>
        </div>
    </div>

    <style>
    .ad-checker-container {
        background: #fff; border: 3px solid #3498db; border-radius: 15px; padding: 25px;
        max-width: 450px; margin: 20px auto; text-align: center; font-family: 'Segoe UI', sans-serif;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .instruction { color: #e67e22; font-weight: bold; font-size: 15px; margin-bottom: 15px; }
    #statusIcon { font-size: 40px; margin: 10px 0; }
    .premium-btn {
        background: #3498db; color: white; border: none; padding: 15px 30px;
        font-size: 18px; font-weight: bold; border-radius: 50px; cursor: pointer; width: 100%;
    }
    .premium-btn:disabled { background: #bdc3c7; }

    .modal {
        display: none; position: fixed; z-index: 100000; left: 0; top: 0;
        width: 100%; height: 100%; background-color: rgba(0,0,0,0.6);
    }
    .modal-content {
        background-color: #fff; margin: 20% auto; padding: 25px;
        border-radius: 15px; width: 80%; max-width: 350px; text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3); animation: slideIn 0.3s ease-out;
    }
    .modal-icon { font-size: 40px; display: block; margin-bottom: 10px; }
    #modalMsg { color: #333; font-weight: bold; font-size: 16px; margin-bottom: 20px; line-height: 1.5; }
    .modal-btn {
        background: #e74c3c; color: white; border: none; padding: 10px 20px;
        border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%;
    }
    @keyframes slideIn {
        from { transform: translateY(-50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    </style>

    <script>
    const smartLink = 'https://snaptik.kim/#google_vignette';
    const storyLink = 'https://kathaxnew.blogspot.com/2026/02/nangi-yaluwa.html';
    const requiredTime = 5000; // මෙතන 20000 තිබුණ එක 5000 (තත්පර 5) කළා

    window.onload = function() {
        checkProgress();
    };

    window.addEventListener('pageshow', function(event) {
        checkProgress();
    });

    function handleAdClick() {
        const startTime = new Date().getTime();
        localStorage.setItem("ad_start_time", startTime);
        localStorage.setItem("is_verifying", "true");
        window.location.href = smartLink;
    }

    function checkProgress() {
        const verifying = localStorage.getItem("is_verifying");
        const startTime = localStorage.getItem("ad_start_time");

        if (localStorage.getItem("story_unlocked") === "true") {
            setUnlockedUI();
            return;
        }

        if (verifying === "true" && startTime) {
            let currentTime = new Date().getTime();
            let timeSpent = currentTime - parseInt(startTime);

            if (timeSpent >= requiredTime) {
                localStorage.setItem("story_unlocked", "true");
                localStorage.removeItem("is_verifying");
                setUnlockedUI();
            } else {
                let remaining = Math.ceil((requiredTime - timeSpent) / 1000);
                showModal("තව තත්පර " + remaining + " ක් ඇඩ් එකේ රැඳී සිටිය යුතුයි. කරුණාකර නැවත උත්සාහ කරන්න.");
                localStorage.removeItem("is_verifying");
                localStorage.removeItem("ad_start_time");
            }
        }
    }

    function setUnlockedUI() {
        document.getElementById('displayMsg').innerHTML = "සාර්ථකයි! දැන් ඔබට කතාව කියවිය හැක.";
        document.getElementById('instructionLine').style.display = 'none';
        document.getElementById('statusIcon').innerHTML = "✅";
        const btn = document.getElementById('actionBtn');
        btn.innerHTML = "කතාව කියවන්න 📖";
        btn.disabled = false;
        btn.style.background = "#27ae60";
        btn.onclick = function() { 
            localStorage.removeItem("story_unlocked");
            localStorage.removeItem("ad_start_time");
            window.location.href = storyLink; 
        };
    }

    function showModal(msg) {
        document.getElementById('modalMsg').innerHTML = msg;
        document.getElementById('customAlert').style.display = "block";
    }

    function closeModal() {
        document.getElementById('customAlert').style.display = "none";
    }
    </script>

</div>
